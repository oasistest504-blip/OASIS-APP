# Configuración opcional para WhatsApp Cloud API real (si se deja vacío, funciona en modo simulado)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Firebase Admin SDK (JSON de cuenta de servicio en una sola línea o base64)
# FIREBASE_SERVICE_ACCOUNT=

# Protección opcional para Vercel Cron / api/secuencia/correr
# CRON_SECRET=
