rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- ayudas ----------------

    function conSesion() {
      return request.auth != null;
    }

    function camposTocados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function soloEstosCampos(permitidos) {
      return camposTocados().hasOnly(permitidos);
    }

    // ---------------- configuración: las contraseñas ----------------
    match /configuracion/{docId} {
      allow read, write: if conSesion();
    }

    // ---------------- usuarios: líderes y Apóstol ----------------
    match /usuarios/{uid} {
      allow read, write: if conSesion();
    }

    // ---------------- personas ----------------
    match /personas/{id} {
      allow read: if conSesion();
      allow create: if conSesion()
                    && request.resource.data.consentimiento.otorgado == true
                    && request.resource.data.telefonoE164 is string
                    && request.resource.data.telefonoE164.size() >= 10
                    && request.resource.data.telefonoE164.size() <= 15;
      allow update: if conSesion()
                    && soloEstosCampos([
                      'etapa', 'banderas', 'notas', 'ultimoContacto',
                      'motivoOracion', 'liderAsignadoId', 'liderAsignadoNombre',
                      'ventanaAbiertaHasta', 'sinRespuestaConsecutivos', 'pasosEnviados'
                    ]);
      allow delete: if false;
    }

    // ---------------- tareas ----------------
    match /tareas/{id} {
      allow read, create: if conSesion();
      allow update: if conSesion()
                    && soloEstosCampos([
                      'estado', 'completadaEn', 'nota', 'liderId', 'liderNombre'
                    ]);
      allow delete: if false;
    }

    // ---------------- interacciones ----------------
    match /interacciones/{id} {
      allow read, create: if conSesion();
      allow update, delete: if false;
    }

    // ---------------- difusiones ----------------
    match /difusiones/{id} {
      allow read, create: if conSesion();
      allow update, delete: if false;
    }

    // ---------------- auditoría ----------------
    match /auditoria/{id} {
      allow read, create: if conSesion();
      allow update, delete: if false;
    }

    // ---------------- captura general ----------------
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
